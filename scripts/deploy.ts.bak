const { toNano } = require('@ton/core');
const { CarbonRewards } = require('../build/CarbonRewards/carbon_rewards_CarbonRewards');

async function run(provider) {
    const carbonRewards = provider.open(await CarbonRewards.fromInit());

    await carbonRewards.send(
        provider.sender(),
        {
            value: toNano('0.05'),
        },
        {
            $$type: 'Deploy',
            queryId: 0n,
        }
    );

    await provider.waitForDeploy(carbonRewards.address);

    console.log('\n==================================================');
    console.log('✅ DEPLOY THÀNH CÔNG LÊN TESTNET!');
    console.log('📍 Địa chỉ Contract Testnet:', carbonRewards.address.toString({ testOnly: true }));
    console.log('==================================================\n');
}

module.exports = { run };