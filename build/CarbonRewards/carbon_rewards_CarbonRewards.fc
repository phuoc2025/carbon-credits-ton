}

((slice, int, int, int), (int, int, int)) $CarbonRewards$_fun_getMetrics((slice, int, int, int) $self) impure inline_ref {
    var (($self'owner, $self'total_co2e_reduced_kg, $self'total_carbon_credits_minted, $self'total_sc_points_minted)) = $self;
