;;
;; Routing of a Contract CarbonRewards
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'owner, $self'total_co2e_reduced_kg, $self'total_carbon_credits_minted, $self'total_sc_points_minted) = $CarbonRewards$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
        ;; Receive Deploy message
        if (op == 0x946a98b6) {
            var $deploy'queryId = in_msg~load_uint(64);
            ($self'owner, $self'total_co2e_reduced_kg, $self'total_carbon_credits_minted, $self'total_sc_points_minted)~$CarbonRewards$_fun_notify($DeployOk$_store_cell($DeployOk$_constructor_queryId($deploy'queryId), begin_cell()));
            $CarbonRewards$_contract_store(($self'owner, $self'total_co2e_reduced_kg, $self'total_carbon_credits_minted, $self'total_sc_points_minted));
            return ();
        }
        
    }
    ;; Empty Receiver and Text Receivers
    var text_op = slice_hash(in_msg);
    ;; Receive "RecordCarbon" message
    if (text_op == 0x1c953e627f977e7e40784729899cdf5131546bb4525bf81569fd40c8adfd7e1d) {
        $self'total_co2e_reduced_kg = ($self'total_co2e_reduced_kg + 1000);
        $self'total_carbon_credits_minted = ($self'total_carbon_credits_minted + 1);
        $self'total_sc_points_minted = ($self'total_sc_points_minted + 100);
        $CarbonRewards$_contract_store(($self'owner, $self'total_co2e_reduced_kg, $self'total_carbon_credits_minted, $self'total_sc_points_minted));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
