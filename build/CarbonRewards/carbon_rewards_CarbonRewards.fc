;;
;; Type: CarbonRewards
;; TLB: _ owner:address total_co2e_reduced_kg:uint64 total_carbon_credits_minted:uint64 total_sc_points_minted:uint64 = CarbonRewards
;;

builder $CarbonRewards$_store(builder build_0, (slice, int, int, int) v) inline {
    var (v'owner, v'total_co2e_reduced_kg, v'total_carbon_credits_minted, v'total_sc_points_minted) = v;
    build_0 = build_0.store_slice(v'owner);
    build_0 = build_0.store_uint(v'total_co2e_reduced_kg, 64);
    build_0 = build_0.store_uint(v'total_carbon_credits_minted, 64);
    build_0 = build_0.store_uint(v'total_sc_points_minted, 64);
    return build_0;
}

(slice, ((slice, int, int, int))) $CarbonRewards$_load(slice sc_0) inline {
    var v'owner = sc_0~load_msg_addr();
    var v'total_co2e_reduced_kg = sc_0~load_uint(64);
    var v'total_carbon_credits_minted = sc_0~load_uint(64);
    var v'total_sc_points_minted = sc_0~load_uint(64);
    return (sc_0, (v'owner, v'total_co2e_reduced_kg, v'total_carbon_credits_minted, v'total_sc_points_minted));
}

(slice, int, int, int) $CarbonRewards$_contract_load() impure inline {
    slice $sc = get_data().begin_parse();
    int $loaded = $sc~load_int(1);
    if ($loaded) {
        return $sc~$CarbonRewards$_load();
    }
    else {
        return $CarbonRewards$_contract_init();
    }
}

() $CarbonRewards$_contract_store((slice, int, int, int) v) impure inline {
    builder b = begin_cell();
    b = b.store_int(true, 1);
    b = $CarbonRewards$_store(b, v);
    set_data(b.end_cell());
}

